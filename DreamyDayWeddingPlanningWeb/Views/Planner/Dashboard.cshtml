@model DreamyDayWeddingPlanningWeb.Models.Planner.PlannerDashboardViewModel

<style>
    .dashboard-card {
        background: #f8f9fa;
        border-left: 5px solid #007bff;
    }

    .status-badge {
        font-size: 0.9em;
    }

    .quick-actions .btn {
        width: 100%;
        margin-bottom: 10px;
        font-size: 1.1em;
    }

    .table th, .table td {
        vertical-align: middle;
    }

    .card {
        margin-bottom: 20px;
    }
</style>

<div class="container-fluid mt-4">
    <h2 class="mb-4">Planner Dashboard</h2>

    <!-- Summary Cards -->
    <div class="row mb-3">
        <div class="col-md-4">
            <div class="card text-white bg-primary">
                <div class="card-body">
                    <h5 class="card-title">Weddings</h5>
                    <p class="card-text">@Model.TotalWeddings</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card text-white bg-success">
                <div class="card-body">
                    <h5 class="card-title">Tasks Completed</h5>
                    <p class="card-text">@Model.TasksCompleted / @Model.TasksTotal</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card text-white bg-info">
                <div class="card-body">
                    <h5 class="card-title">Upcoming Tasks</h5>
                    @foreach (var task in Model.UpcomingTasks)
                    {
                        <div><strong>@task.TaskName</strong> - @task.Deadline.ToShortDateString()</div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Notifications -->
    <div class="card mb-4">
        <div class="card-header bg-secondary text-white">🔔 Notifications</div>
        <ul class="list-group list-group-flush">
            @foreach (var note in Model.Notifications)
            {
                <li class="list-group-item">
                    @note.Message
                    <span class="text-muted small float-right">@note.Date.ToShortTimeString()</span>
                </li>
            }
        </ul>
    </div>

    <!-- All Weddings + Quick Actions -->
    <div class="row">
        <!-- All Weddings Table -->
        <div class="col-lg-9 col-md-8">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <i class="fas fa-calendar-alt"></i> All Weddings
                </div>
                <div class="table-responsive">
                    <table class="table table-striped table-bordered wedding-table">
                        <thead class="table-primary text-dark">
                            <tr>
                                <th>Couple</th>
                                <th>Date</th>
                                <th>Status</th>
                                <th>Budget</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var wedding in Model.AllWeddings)
                            {
                                <tr>
                                    <td>@wedding.CoupleName</td>
                                    <td>@wedding.WeddingDate.ToShortDateString()</td>
                                    <td>
                                        @if (wedding.IsCompleted)
                                        {
                                            <span class="badge bg-success text-white">✅ Completed</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark">🕒 Ongoing</span>
                                        }
                                    </td>
                                    <td>$@wedding.Budget.ToString("F2")</td>
                                    <td>
                                        <form asp-action="ToggleWeddingStatus" method="post" asp-controller="Planner">
                                            <input type="hidden" name="id" value="@wedding.WeddingId" />
                                            <button class="btn btn-sm btn-outline-secondary">Toggle Status</button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Quick Actions Panel -->
        <div class="col-lg-3 col-md-4 quick-actions">
            <div class="card bg-light p-3">
                <h5 class="text-primary">Quick Actions</h5>
                <a href="/Planner/ManageTasks" class="btn btn-outline-primary">📋 Manage Tasks</a>
                <a href="/Planner/ManageVendors" class="btn btn-outline-primary">🛍 Manage Vendors</a>
                <a href="/Planner/Timeline" class="btn btn-outline-primary">📅 Edit Timeline</a>
                <a href="/Planner/Reports" class="btn btn-outline-primary">📊 View Reports</a>
            </div>
        </div>
    </div>
</div>
