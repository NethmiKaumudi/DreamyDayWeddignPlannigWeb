@model List<DreamyDayWeddingPlanningWeb.Models.Planner.TimelineEventViewModel>
@{
    ViewData["Title"] = "Edit Wedding Timeline";
    var weddings = ViewBag.Weddings as List<DreamyDayWeddingPlanningWeb.Models.Wedding>;
    var selectedWeddingId = ViewBag.SelectedWeddingId as int?;
}

<h2 class="mb-4">📅 Wedding Timeline</h2>

<!-- Wedding selection -->
<form method="get" asp-action="Timeline" class="mb-3 d-flex align-items-center">
    <label class="me-2">Select Wedding:</label>
    <select name="weddingId" class="form-select me-2" style="width: 300px;">
        <option value="">-- Choose a wedding --</option>
        @foreach (var w in ViewBag.Weddings as List<DreamyDayWeddingPlanningWeb.Models.Wedding>)
        {
            var isSelected = (ViewBag.SelectedWeddingId != null && (int)ViewBag.SelectedWeddingId == w.Id);
            <option value="@w.Id" selected="@(isSelected ? "selected" : null)">@w.WeddingTitle</option>
        }

    </select>
    <button type="submit" class="btn btn-primary">Load Timeline</button>
</form>

<!-- Add Event Button -->
<button class="btn btn-success mb-3" data-bs-toggle="modal" data-bs-target="#addTimelineModal">
    ➕ Add New Event
</button>

<!-- Timeline Table -->
<table class="table table-bordered table-striped">
    <thead class="table-dark">
        <tr>
            <th>Event</th>
            <th>Start</th>
            <th>End</th>
            <th>Description</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.Any())
        {
            foreach (var item in Model)
            {
                <tr>
                    <td>@item.EventName</td>
                    <td>@item.StartTime.ToString("g")</td>
                    <td>@item.EndTime.ToString("g")</td>
                    <td>@item.Description</td>
                    <td>
                        <button class="btn btn-sm btn-info me-2 edit-btn"
                                data-id="@item.Id"
                                data-name="@item.EventName"
                                data-start="@item.StartTime.ToString("yyyy-MM-ddTHH:mm")"
                                data-end="@item.EndTime.ToString("yyyy-MM-ddTHH:mm")"
                                data-desc="@item.Description"
                                data-bs-toggle="modal"
                                data-bs-target="#editTimelineModal">
                            ✏️ Edit
                        </button>
                        <button class="btn btn-sm btn-danger delete-btn"
                                data-id="@item.Id"
                                data-bs-toggle="modal"
                                data-bs-target="#deleteTimelineModal">
                            🗑 Delete
                        </button>
                    </td>
                </tr>
            }
        }
        else
        {
            <tr><td colspan="5" class="text-center">No timeline events found.</td></tr>
        }
    </tbody>
</table>

<!-- Add Modal -->
<div class="modal fade" id="addTimelineModal" tabindex="-1" aria-labelledby="addTimelineLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-action="AddTimelineEvent">
                <div class="modal-header bg-success text-white">
                    <h5 class="modal-title" id="addTimelineLabel">Add Timeline Event</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="WeddingId" value="@selectedWeddingId" />
                    <div class="mb-3">
                        <label>Event Name</label>
                        <input type="text" name="EventName" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label>Start Time</label>
                        <input type="datetime-local" name="StartTime" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label>End Time</label>
                        <input type="datetime-local" name="EndTime" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label>Description</label>
                        <textarea name="Description" class="form-control" rows="3"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-success">Save</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Edit Modal -->
<div class="modal fade" id="editTimelineModal" tabindex="-1" aria-labelledby="editTimelineLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-action="EditTimelineEvent">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title" id="editTimelineLabel">Edit Timeline Event</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="Id" id="edit-id" />
                    <div class="mb-3">
                        <label>Event Name</label>
                        <input type="text" name="EventName" id="edit-name" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label>Start Time</label>
                        <input type="datetime-local" name="StartTime" id="edit-start" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label>End Time</label>
                        <input type="datetime-local" name="EndTime" id="edit-end" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label>Description</label>
                        <textarea name="Description" id="edit-desc" class="form-control" rows="3"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-primary">Update</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Delete Modal -->
<div class="modal fade" id="deleteTimelineModal" tabindex="-1" aria-labelledby="deleteTimelineLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-action="DeleteTimelineEvent">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title" id="deleteTimelineLabel">Delete Timeline Event</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    Are you sure you want to delete this event?
                    <input type="hidden" name="id" id="delete-id" />
                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-danger">Delete</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $('.edit-btn').click(function () {
            $('#edit-id').val($(this).data('id'));
            $('#edit-name').val($(this).data('name'));
            $('#edit-start').val($(this).data('start'));
            $('#edit-end').val($(this).data('end'));
            $('#edit-desc').val($(this).data('desc'));
        });

        $('.delete-btn').click(function () {
            $('#delete-id').val($(this).data('id'));
        });
    </script>
}
