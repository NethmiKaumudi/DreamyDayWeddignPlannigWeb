@model List<DreamyDayWeddingPlanningWeb.Models.Planner.VendorViewModel>
@using DreamyDayWeddingPlanningWeb.Models
@using DreamyDayWeddingPlanningWeb.Areas.Identity.Data

@{
    ViewBag.Title = "Manage Vendors";
    var weddings = ViewBag.Weddings as List<Wedding>;
}

<div class="container py-4" style="background-color: #0b1f3a;">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="text-white">Available Vendors</h2>
        <button class="btn btn-success" data-bs-toggle="offcanvas" data-bs-target="#addVendorSidebar">
            ➕ Add Vendor
        </button>
    </div>

    <form asp-action="FilterVendors" asp-controller="Planner" method="get">
        <select name="weddingId" class="form-select w-auto me-2">
            <option value="">All Weddings</option>
            @foreach (var wedding in ViewBag.Weddings as List<Wedding>)
            {
                <option value="@wedding.Id">@wedding.WeddingTitle</option>
            }
        </select>
        <button class="btn btn-outline-primary">Filter</button>
    </form>


    <div class="row">
        @foreach (var vendor in Model)
        {
            <div class="col-md-6">
                <div class="card mb-4 bg-secondary text-white shadow-sm">
                    <div class="card-body">
                        <h5 class="card-title">@vendor.Name (@vendor.Category)</h5>
                        <p class="card-text">@vendor.Description</p>
                        <p><strong>Price:</strong> $@String.Format("{0:0.00}", vendor.Price)</p>


                        @if (vendor.IsAssigned)
                        {
                            <span class="badge bg-success">Assigned to: @vendor.WeddingTitle</span>

                            <br />
                            <small>Notes: @vendor.Notes</small>

                            <br />
                            <small>Priority: @vendor.Priority</small>
                        }

                        <form asp-controller="Planner" asp-action="BookVendor" method="post" class="mt-3">
                            <input type="hidden" name="vendorId" value="@vendor.Id" />
                            <select name="weddingId" class="form-select mb-2" required>
                                @foreach (var w in weddings)
                                {
                                    <option value="@w.Id">@w.WeddingTitle</option>
                                }
                            </select>
                            <input type="text" name="notes" class="form-control mb-2" placeholder="Notes (optional)" />
                            <input type="number" name="priority" class="form-control mb-2" placeholder="Priority (1-5)" min="1" max="5" />
                            <button class="btn btn-primary w-100">📌 Book Vendor</button>
                        </form>

                        <form asp-controller="Planner" asp-action="DeleteVendor" method="post" class="mt-2">
                            <input type="hidden" name="id" value="@vendor.Id" />
                            <button class="btn btn-danger btn-sm w-100">🗑 Delete Vendor</button>
                        </form>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<!-- Offcanvas Sidebar for Add/Edit Vendor -->
<div class="offcanvas offcanvas-end" tabindex="-1" id="addVendorSidebar">
    <div class="offcanvas-header">
        <h5 class="offcanvas-title">Add Vendor</h5>
        <button type="button" class="btn-close text-reset" data-bs-dismiss="offcanvas"></button>
    </div>
    <div class="offcanvas-body">
        <form asp-controller="Planner" asp-action="AddVendor" method="post">
            <div class="mb-3">
                <label class="form-label">Name</label>
                <input name="Name" class="form-control" required />
            </div>
            <div class="mb-3">
                <label class="form-label">Category</label>
                <input name="Category" class="form-control" required />
            </div>
            <div class="mb-3">
                <label class="form-label">Description</label>
                <textarea name="Description" class="form-control" required></textarea>
            </div>
            <div class="mb-3">
                <label class="form-label">Price</label>
                <input name="Price" type="number" class="form-control" step="0.01" required />
            </div>
            <button type="submit" class="btn btn-success w-100">Save Vendor</button>
        </form>
    </div>
</div>